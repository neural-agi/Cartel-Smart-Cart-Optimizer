APP_NAME=Cartel
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF_SECONDS=1
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
DATA_DIR=../data
CHECKOUT_OBSERVATION_PROVIDER_MODE=unavailable
CHECKOUT_CAPTURE_ADAPTER_MODE=unavailable
PLANNING_MAX_CART_ITEMS=20
PLANNING_MAX_CANDIDATES_PER_ITEM=20
PLANNING_MAX_COMBINATIONS=10000
PLANNING_MAX_SUPPLIED_PLANS=100
# Optional explicit MVP planning authorities. Values are JSON mappings; leave
# blank to keep the corresponding provider fail-closed.
PLANNING_RETAILER_IDENTITY_MAP={}
PLANNING_CHECKOUT_GROUP_MAP={}
PLANNING_INCONVENIENCE_PENALTY_UNITS=
PLANNING_RETAILER_PREFERENCE_PRIORITY=
PLANNING_FEASIBILITY=
PLANNING_FEASIBILITY_EVIDENCE=
OPTIMIZATION_POLICY_VERSION=policy-v1
BLINKIT_DELIVERY_LOCATION_NAME=Gurugram
BLINKIT_DELIVERY_LATITUDE=28.413333
BLINKIT_DELIVERY_LONGITUDE=77.072833
BLINKIT_GEOLOCATION_ACCURACY=50
BLINKIT_SESSION_STATE_PATH=../data/sessions/blinkit/browser_state.json
# Optional diagnostic/authorized runtime override. Leave blank to use the
# Playwright-managed browser installed by the backend image.
BLINKIT_BROWSER_EXECUTABLE_PATH=

DATABASE_REQUIRED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cartel
POSTGRES_USER=cartel
POSTGRES_PASSWORD=
AUTH_SESSION_DAYS=14
AUTH_IDLE_DAYS=7
AUTH_CHALLENGE_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=8
AUTH_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
