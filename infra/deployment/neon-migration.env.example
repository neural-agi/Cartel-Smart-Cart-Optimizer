# Neon migration-only environment (Architecture A)
#
# Use the DIRECT Neon endpoint (host WITHOUT "-pooler") for Alembic. The
# application runtime uses the pooled endpoint instead.
#
# This file is a template. Export the real value in the shell that runs the
# approved migration; never commit it, never paste it into chat, and never
# print it. The migration script masks the target before printing.
#
# Required shape:
#   postgresql+psycopg://<user>:<password>@<neon-direct-host>/<db>?sslmode=require
#
# Expected repository head: 0009_credential_vault (single head).

DATABASE_URL=postgresql+psycopg://<user>:<password>@<neon-direct-host>/<db>?sslmode=require
