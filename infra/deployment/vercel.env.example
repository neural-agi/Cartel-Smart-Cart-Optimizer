# Cartel frontend — Vercel Hobby (Architecture A)
#
# Vercel project settings:
#   Root Directory:        frontend
#   Install Command:       npm ci
#   Build Command:         npm run build
#   Output Directory:      (framework default)
#   Framework Preset:      Next.js
#   Node.js Version:       22.x (matches frontend/Dockerfile)
#
# Add BACKEND_INTERNAL_URL to BOTH Production and Preview environments. It is
# read at build time by frontend/next.config.ts and used only by the server-side
# /api rewrite. It is NOT a NEXT_PUBLIC_ variable and must never reach the
# browser bundle.
#
# Leave NEXT_PUBLIC_API_BASE_URL UNSET. Setting it would make the browser call
# the backend origin directly instead of the same-origin /api rewrite.
#
# A Vercel build without BACKEND_INTERNAL_URL fails on purpose; it will never
# silently fall back to the Docker-only hostname http://api:8000.

BACKEND_INTERNAL_URL=https://<render-service>.onrender.com
NEXT_TELEMETRY_DISABLED=1

# Unset (do not add):
# NEXT_PUBLIC_API_BASE_URL
