# Cartel backend — Render Free Web Service (Architecture A)
#
# Copy these keys into the Render Dashboard (Service > Environment).
# Replace every <...> placeholder. Never commit real secrets.
#
# Render service settings:
#   Root Directory:      backend
#   Build Command:       pip install -r requirements.txt
#   Start Command:       uvicorn app.main:app --host 0.0.0.0 --port $PORT
#   Health Check Path:   /ready
#   Python version:      set PYTHON_VERSION=3.12.11 (fully qualified)
#   Instance Type:       Free
#
# Do not run `alembic upgrade head` from the start command. Migrations are a
# separately approved, one-time gate (see infra/deployment/migrate_neon.sh).

APP_NAME=Cartel
APP_ENV=staging
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
DOCS_ENABLED=false

# Browser-visible origin = the Vercel HTTPS origin. Set both to the same exact
# origin (no trailing slash, no path). CORS is exact, never a wildcard.
PUBLIC_ORIGIN=https://<vercel-project>.vercel.app
CORS_ALLOWED_ORIGINS=https://<vercel-project>.vercel.app

AUTH_REQUIRED=true
# Format: user_id=high-entropy-operator-token. Operator-only; never exposed to
# the frontend. Consumer login is GitHub OAuth.
AUTH_TOKENS=<operator-user-id>=<high-entropy-operator-token>
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=14
AUTH_IDLE_DAYS=7
AUTH_CHALLENGE_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=8

# Neon PostgreSQL. Runtime uses the POOLED endpoint (host contains "-pooler").
# The direct endpoint is used only by the separately approved migration step.
# TLS is mandatory.
DATABASE_REQUIRED=true
DATABASE_URL=postgresql+psycopg://<user>:<password>@<neon-pooled-host>/<db>?sslmode=require
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# Upstash Redis. TLS URL; the application rejects non-redis schemes.
REDIS_URL=rediss://default:<password>@<upstash-host>:6379
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_OPERATION_TIMEOUT_SECONDS=1
REDIS_MAX_CONNECTIONS=5

# GitHub OAuth app (server-side secret only).
# Callback must be on the Vercel origin, not the Render origin.
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_REDIRECT_URI=https://<vercel-project>.vercel.app/api/v2/auth/github/callback

# Synthetic CARTEL_DEMO catalog only. The directory is committed to Git and
# read-only at runtime. DATA_DIR resolves against the backend root.
DEMO_FIXTURES_ENABLED=true
DATA_DIR=../data/demo_catalog

# No live retailer acquisition, no checkout capture, no credential vault keys.
RETAILER_DATA_PROVIDER_MODE=unavailable
CHECKOUT_OBSERVATION_PROVIDER_MODE=unavailable
CHECKOUT_CAPTURE_ADAPTER_MODE=unavailable
VAULT_KEY_PROVIDER=unavailable

# Email is deliberately deferred. With an empty SMTP host, signup, resend, and
# password-recovery endpoints return HTTP 503 email_delivery_unavailable.
# Render Free blocks outbound SMTP ports 25, 465, and 587.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
