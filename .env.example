APP_NAME=Cartel
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
DOCS_ENABLED=true
DATA_DIR=/app/data
CHECKOUT_OBSERVATION_PROVIDER_MODE=unavailable
CHECKOUT_CAPTURE_ADAPTER_MODE=unavailable
PLANNING_MAX_CART_ITEMS=20
PLANNING_MAX_CANDIDATES_PER_ITEM=20
PLANNING_MAX_COMBINATIONS=10000
PLANNING_MAX_SUPPLIED_PLANS=100

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cartel
POSTGRES_USER=cartel
POSTGRES_PASSWORD=replace-with-local-development-password
REDIS_URL=redis://redis:6379/0
PUBLIC_ORIGIN=https://cartel.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
AUTH_SESSION_DAYS=14
AUTH_IDLE_DAYS=7
AUTH_CHALLENGE_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=8
AUTH_REQUIRED=false
# Comma-separated operator-provisioned pairs, e.g. user-1=replace-with-secret
AUTH_TOKENS=replace-with-operator-id=replace-with-local-token
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
EMAIL_DELIVERY_MODE=file
