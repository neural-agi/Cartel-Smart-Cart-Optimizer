APP_NAME=Cartel
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
DOCS_ENABLED=true
DATA_DIR=/app/data
CHECKOUT_OBSERVATION_PROVIDER_MODE=unavailable
PLANNING_MAX_CART_ITEMS=20
PLANNING_MAX_CANDIDATES_PER_ITEM=20
PLANNING_MAX_COMBINATIONS=10000
PLANNING_MAX_SUPPLIED_PLANS=100

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cartel
POSTGRES_USER=cartel
POSTGRES_PASSWORD=cartel
REDIS_URL=redis://redis:6379/0
